# Local development settings for the API. Copy to apps/api/.env:
#   cp apps/api/.env.example apps/api/.env
# `pnpm dev` and `pnpm db:migrate` read it; real environment variables win
# over it. Production does not use this file: see
# deploy/production/api.env.example and docs/deploy/.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# development, test or production. Only development allows DEV_LOGIN and
# plain-http URLs.
APP_ENV=development
PORT=8080
# Matches docker-compose.yml (`pnpm db:up`).
DATABASE_URL=postgres://airship:airship@localhost:5432/airship?sslmode=disable
# debug, info, warn or error. Logs are text in development, JSON otherwise.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------

# Where browsers, GitHub and runner machines reach this API. Must be https
# outside development. For webhooks during local development, put a tunnel
# URL here (docs/development.md, "Receiving real jobs").
PUBLIC_URL=http://localhost:8080
# The dashboard; GitHub sign-in returns here.
WEB_URL=http://localhost:3000
# Browser origins allowed to call the API, comma-separated. Include WEB_URL.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Sign-in
# ---------------------------------------------------------------------------

# Signs you in as a local "dev" user, an admin of a demo organization
# "acme", without GitHub. Startup fails if set outside development.
DEV_LOGIN=true

# ---------------------------------------------------------------------------
# Credential sealing
# ---------------------------------------------------------------------------

# Seals customers' cloud credentials in the database (base64, 32 bytes).
# This key is public. Startup fails if it is used outside development.
# Generate your own with:
#   openssl rand -base64 32
# To rotate, list the new key first and the old one after a comma, deploy,
# reconnect each cloud (which seals with the new key), then drop the old.
CREDENTIALS_KEY=LwPTIJ8fQ2YUuXCSPYH/h/esBGBJ5udmiu5NaCngjaQ=

# ---------------------------------------------------------------------------
# GitHub App
# ---------------------------------------------------------------------------

# Without these the dashboard works with DEV_LOGIN, but GitHub sign-in,
# webhooks and launches are off. Use a separate app for development; see
# docs/development.md, "Creating a development GitHub App".
# GITHUB_APP_SLUG=airship-dev-yourname
# GITHUB_CLIENT_ID=Iv23li...
# GITHUB_CLIENT_SECRET=...
# GITHUB_WEBHOOK_SECRET=...
# Either a path to the PEM file (paths are relative to apps/api) ...
# GITHUB_PRIVATE_KEY_FILE=./github-app.pem
# ... or the PEM itself, on one line with literal \n.
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# GitHub Enterprise Server, or a fake GitHub (defaults shown).
# GITHUB_API_URL=https://api.github.com
# GITHUB_WEB_URL=https://github.com

# ---------------------------------------------------------------------------
# Runner lifecycle (defaults shown)
# ---------------------------------------------------------------------------

# The actions/runner release machines install. GitHub stops sending jobs
# to runners more than 30 days behind the latest release.
# RUNNER_VERSION=2.338.2
# Machines power off after this. Raise it for jobs whose timeout-minutes is
# longer.
# RUNNER_MAX_LIFETIME=8h
# RUNNER_IDLE_TIMEOUT=10m
# RECONCILE_INTERVAL=15s
# LAUNCH_INTERVAL=2s

# ---------------------------------------------------------------------------
# Cloud emulators (local testing only)
# ---------------------------------------------------------------------------

# Point a provider at an emulator or stand-in API instead of the real cloud.
# AWS_ENDPOINT=http://localhost:5055      # moto
# GCP_ENDPOINT=http://localhost:5056
# AZURE_ENDPOINT=http://localhost:5058
# DAYTONA_ENDPOINT=http://localhost:5057  # replaces the URL each credential carries

# ---------------------------------------------------------------------------
# Tests (not read from this file)
# ---------------------------------------------------------------------------

# `go test` reads these from the shell, not from .env. Export them or put
# them before the command. docs/development.md, "Tests", has the details.
#   TEST_DATABASE_URL=postgres://airship:airship@localhost:5432/airship?sslmode=disable
#   AIRSHIP_AWS_ENDPOINT=http://localhost:5055
#   AIRSHIP_LIVE_AWS_ACCESS_KEY_ID, AIRSHIP_LIVE_AWS_SECRET_ACCESS_KEY, AIRSHIP_LIVE_AWS_REGION
#   AIRSHIP_LIVE_GCP_KEY_FILE, AIRSHIP_LIVE_GCP_LOCATION
#   AIRSHIP_LIVE_AZURE_TENANT_ID, AIRSHIP_LIVE_AZURE_CLIENT_ID, AIRSHIP_LIVE_AZURE_CLIENT_SECRET,
#   AIRSHIP_LIVE_AZURE_SUBSCRIPTION_ID, AIRSHIP_LIVE_AZURE_REGION
#   AIRSHIP_LIVE_DAYTONA_API_KEY, AIRSHIP_LIVE_DAYTONA_API_URL, AIRSHIP_LIVE_DAYTONA_REGION

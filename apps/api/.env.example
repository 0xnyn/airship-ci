# Copy to .env for local development. Real environment variables win over .env.
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://airship:airship@localhost:5432/airship?sslmode=disable
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Where this API and the dashboard are reachable. In production PUBLIC_URL
# must be https; it is the URL agents and GitHub webhooks use.
PUBLIC_URL=http://localhost:8080
WEB_URL=http://localhost:3000

# Sign in as a local "dev" user without GitHub. Only honored in development.
DEV_LOGIN=true

# Seals customers' cloud credentials in the database (base64, 32 bytes).
# This one is public and is refused outside APP_ENV=development; generate
# your own:
#   openssl rand -base64 32
# To rotate, list the new key first and the old one after a comma, deploy,
# reconnect each cloud (which seals with the new key), then drop the old.
CREDENTIALS_KEY=LwPTIJ8fQ2YUuXCSPYH/h/esBGBJ5udmiu5NaCngjaQ=

# GitHub App (see README "Creating the GitHub App"). Without these the
# dashboard works, but sign-in with GitHub, webhooks and launches are off.
# GITHUB_APP_SLUG=airship-dev
# GITHUB_CLIENT_ID=Iv23li...
# GITHUB_CLIENT_SECRET=...
# GITHUB_PRIVATE_KEY_FILE=./github-app.pem
# GITHUB_WEBHOOK_SECRET=...

# Runner lifecycle (defaults shown).
# RUNNER_VERSION=2.338.2
# RUNNER_MAX_LIFETIME=8h
# RUNNER_IDLE_TIMEOUT=10m
# RECONCILE_INTERVAL=15s
# LAUNCH_INTERVAL=2s

# Point the AWS provider at an emulator such as moto (tests only).
# AWS_ENDPOINT=http://localhost:5055

# Local overrides for the dashboard. Optional: .env.schema already has
# working defaults for `pnpm dev`. Copy to apps/dash/.env.local to override:
#   cp apps/dash/.env.example apps/dash/.env.local
# varlock validates every value against .env.schema at startup and build.

# The Go API (apps/api). Change it only when the API is not on
# localhost:8080, e.g. behind a development tunnel (docs/development.md).
# Production builds refuse a localhost value, and the value is inlined into
# the JavaScript when `next build` runs, so set it in the build environment.
NEXT_PUBLIC_API_URL=http://localhost:8080

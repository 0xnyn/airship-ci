# @public @type=enum(development, production, test)
NODE_ENV=development

# Base URL of the Go API (apps/api).
# @public @type=url
NEXT_PUBLIC_API_URL=http://localhost:8080

# This dashboard's own public URL, which share previews need to link the
# social card absolutely. Unset, Next.js uses Vercel's production URL there
# and localhost anywhere else.
# @public @type=url @optional
NEXT_PUBLIC_APP_URL=

# Overrides for the marketing site (apps/home). Optional: without them the
# site links to the production URLs in src/content/site.ts. Copy to
# apps/home/.env (`make env` does) and uncomment what you need.
#
# Astro inlines PUBLIC_* values when the site is built, so a static build
# keeps whatever was set at build time. Leave a line commented rather than
# empty: an empty value replaces the default with "".

# The dashboard: the pricing plans' "Start for free" and the "Connect a cloud" button.
# PUBLIC_APP_URL=http://localhost:3000

# The documentation site.
# PUBLIC_DOCS_URL=https://docs.airshipci.com

# The API, shown in the developer-API example on the page.
# PUBLIC_API_URL=http://localhost:8080

# The Cal booking page: the "Get started" and "Talk to us" buttons.
# PUBLIC_CAL_URL=https://cal.com/airship/quick-chat

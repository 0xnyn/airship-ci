---
// A file card with light YAML/shell highlighting done at build time.
interface Props {
  class?: string;
  code: string;
  file: string;
}
const { file, code, class: className } = Astro.props;

const escapeHtml = (s: string): string =>
  s.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");

const COMMENT = /(\s#.*|^#.*)$/;
const KEY = /^(\s*-?\s*)([\w.$-]+)(:)(?=\s|$)/;
const STRING = /("[^"]*"|'[^']*')/g;
const NUMBER_OR_BOOL = /(:\s+)(true|false|\d[\d.]*)(\s*$)/;
const EXPRESSION = /(\$\{\{[^}]*\}\})/g;

const highlight = (line: string): string => {
  const commentMatch = line.match(COMMENT);
  const comment = commentMatch ? commentMatch[0] : "";
  let body = escapeHtml(comment ? line.slice(0, -comment.length) : line);
  body = body
    .replace(STRING, '<span class="t-str">$1</span>')
    .replace(EXPRESSION, '<span class="t-expr">$1</span>')
    .replace(KEY, '$1<span class="t-key">$2</span>$3')
    .replace(NUMBER_OR_BOOL, '$1<span class="t-lit">$2</span>$3');
  return comment
    ? `${body}<span class="t-com">${escapeHtml(comment)}</span>`
    : body;
};

const html = code
  .trim()
  .split("\n")
  .map((l) => `<span class="line">${highlight(l) || " "}</span>`)
  .join("\n");
---

<figure class:list={["code-card", className]}>
  <figcaption class="code-file">
    <span class="code-dots"><i></i><i></i><i></i></span>
    {file}
  </figcaption>
  <pre><code set:html={html} /></pre>
</figure>

<style>
  .code-card {
    background: rgb(12, 13, 15);
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
  }

  .code-file {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 14px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--white-50);
  }

  .code-dots {
    display: flex;
    gap: 4px;
  }

  .code-dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--btn-dark-bg);
  }

  pre {
    margin: 0;
    padding: 14px 16px 16px;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 12px;
    line-height: 19px;
    color: var(--white-80);
  }

  pre code {
    font-family: var(--font-mono);
  }

  pre :global(.t-key) {
    color: var(--dot-cyan);
  }

  pre :global(.t-str) {
    color: var(--dot-yellow);
  }

  pre :global(.t-lit) {
    color: #ffb36b;
  }

  pre :global(.t-expr) {
    color: #c7b3ff;
  }

  pre :global(.t-com) {
    color: var(--white-30);
  }
</style>

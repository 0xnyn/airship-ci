---
// A still of the Airship dashboard's runner list, drawn in HTML so it stays
// sharp. Rows come from content and follow the real lifecycle:
// pending → launching → running → busy → finished.
import { brand } from "@airship/tokens/tokens";
import type { Fleet } from "../../content/home";

interface Props {
  fleet: Fleet;
}
const { fleet } = Astro.props;
const { rows, stats } = fleet;
---

<div class="panel">
  <div class="panel-bar">
    <div class="panel-crumbs">
      <svg viewBox={brand.markViewBox} width="12" height="12" aria-hidden="true">
        <path d={brand.mark} fill="currentColor"></path>
      </svg>
      <span>{fleet.org}</span>
      <span class="slash">/</span>
      <span class="crumb-on">{fleet.page}</span>
    </div>
    <div class="panel-live"><span class="live-dot"></span>live</div>
  </div>

  <div class="panel-stats">
    {
      stats.map((s) => (
        <div class="stat">
          <span class="stat-label">{s.label}</span>
          <span class="stat-value">{s.value}</span>
        </div>
      ))
    }
  </div>

  <div class="table" role="table" aria-label="Runners">
    <div class="tr th" role="row">
      <span role="columnheader">Job</span>
      <span role="columnheader">Label</span>
      <span role="columnheader">Machine</span>
      <span role="columnheader" class="col-region">Region</span>
      <span role="columnheader">State</span>
      <span role="columnheader" class="col-time">Time</span>
    </div>
    {
      rows.map((r) => (
        <div class="tr" role="row">
          <span role="cell" class="cell-job">
            <span class="job">{r.job}</span>
            <span class="repo">{r.repo}</span>
          </span>
          <span role="cell">
            <code class="label">{r.label}</code>
          </span>
          <span role="cell" class="cell-machine">
            <span class={`cloud cloud-${r.cloud.toLowerCase()}`}>{r.cloud}</span>
            <span class="type">{r.type}</span>
            {r.spot && <span class="spot">spot</span>}
          </span>
          <span role="cell" class="col-region muted">
            {r.region}
          </span>
          <span role="cell">
            <span class={`state state-${r.state}`}>
              <span class="state-dot" />
              {r.state}
            </span>
          </span>
          <span role="cell" class="col-time muted">
            {r.time}
          </span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .panel {
    width: 100%;
    height: 100%;
    background: var(--panel-bg);
    color: var(--white-80);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: -0.2px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .panel-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--line);
  }

  .panel-crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--white-50);
  }

  .slash {
    color: var(--white-30);
  }

  .crumb-on {
    color: var(--white);
  }

  .panel-live {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--white-50);
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--dot-green);
    animation: pulse 2s ease-in-out infinite;
  }

  .panel-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-bottom: 1px solid var(--line);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 20px;
  }

  .stat + .stat {
    border-left: 1px solid var(--line);
  }

  .stat-label {
    color: var(--white-50);
  }

  .stat-value {
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 500;
    color: var(--white);
    letter-spacing: -0.6px;
  }

  .table {
    display: flex;
    flex-direction: column;
  }

  .tr {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.6fr 0.9fr 0.8fr 0.5fr;
    align-items: center;
    gap: 12px;
    padding: 10px 20px;
    border-bottom: 1px solid var(--line-faint);
    white-space: nowrap;
  }

  .th {
    color: var(--white-30);
    padding-top: 12px;
    padding-bottom: 8px;
  }

  .cell-job {
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow: hidden;
  }

  .job {
    color: var(--white);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .repo,
  .muted {
    color: var(--white-50);
  }

  .label {
    color: var(--dot-yellow);
    font-size: 11px;
  }

  .cell-machine {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow: hidden;
  }

  .cloud {
    padding: 1px 5px;
    border-radius: 3px;
    background: var(--btn-dark-bg);
    color: var(--white-80);
    font-size: 10px;
  }

  .cloud-aws {
    color: var(--cloud-aws);
  }

  .cloud-gcp {
    color: var(--cloud-gcp);
  }

  .cloud-azure {
    color: var(--cloud-azure);
  }


  .type {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .spot {
    color: var(--dot-green);
    font-size: 10px;
  }

  .state {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .state-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--white-30);
  }

  .state-busy .state-dot {
    background: var(--dot-blue);
  }

  .state-running .state-dot {
    background: var(--dot-green);
  }

  .state-launching .state-dot {
    background: var(--dot-gold);
    animation: pulse 1s ease-in-out infinite;
  }

  .state-finished {
    color: var(--white-50);
  }

  @keyframes pulse {
    50% {
      opacity: 0.25;
    }
  }

  @media (max-width: 809px) {
    .tr {
      grid-template-columns: 1.4fr 1.4fr 0.9fr;
    }

    .tr > :nth-child(2),
    .col-region,
    .col-time {
      display: none;
    }

    .panel-stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .stat:nth-child(3) {
      border-left: 0;
    }

    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
</style>

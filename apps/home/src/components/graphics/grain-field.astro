---
// A "dawn sky": a diagonal beam of light with a warm-to-cool fringe, drawn
// as a smooth glow with fine static over it. The beam is a band that fades
// down the frame, so there is no edge where the light stops. The static is a
// dither: brightness decides how dense the white grain is, and a colour layer
// multiplied on top tints it. Pure SVG, no raster. The numbers live in
// @airship/tokens, which the dashboard's sign-in draws the same beam from.
import { type BeamOptions, beamGeometry } from "@airship/tokens/beam";
import { beam } from "@airship/tokens/tokens";

interface Props extends BeamOptions {
  id: string;
}
const { id, ...options } = Astro.props;
const g = beamGeometry(options);
const { dither, layers } = beam;
---

<svg
  class="grain-field"
  viewBox={`0 0 ${g.width} ${g.height}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <filter
      id={`${id}-dither`}
      x="0"
      y="0"
      width="100%"
      height="100%"
      color-interpolation-filters="sRGB"
    >
      <feTurbulence
        type="fractalNoise"
        baseFrequency={g.grain}
        numOctaves={dither.octaves}
        seed={dither.seed}
        result="noise"></feTurbulence>
      <feColorMatrix
        in="noise"
        type="matrix"
        values={dither.matrix}
        result="noiseAlpha"></feColorMatrix>
      <feComposite
        in="SourceGraphic"
        in2="noiseAlpha"
        operator="arithmetic"
        k1="0"
        k2="1"
        k3="1"
        k4={dither.threshold}
        result="sum"></feComposite>
      <feComponentTransfer in="sum" result="mask">
        <feFuncA type="discrete" tableValues="0 1"></feFuncA>
      </feComponentTransfer>
      <feFlood flood-color="#fff" result="white"></feFlood>
      <feComposite in="white" in2="mask" operator="in"></feComposite>
    </filter>

    <linearGradient
      id={`${id}-beam`}
      gradientUnits="userSpaceOnUse"
      x1={g.x1}
      y1="0"
      x2={g.x2}
      y2="0"
      gradientTransform={g.transform}
    >
      {
        g.across.map((s) => (
          <stop offset={s.offset} stop-color={s.color} stop-opacity={s.opacity} />
        ))
      }
    </linearGradient>

    <linearGradient id={`${id}-fade`} x1="0" y1="0" x2="0" y2="1">
      {
        g.down.map((s) => (
          <stop offset={s.offset} stop-color={s.color} stop-opacity={s.opacity} />
        ))
      }
    </linearGradient>
    <mask id={`${id}-fade-mask`} maskContentUnits="userSpaceOnUse">
      <rect width={g.width} height={g.height} fill={`url(#${id}-fade)`}></rect>
    </mask>

    <linearGradient
      id={`${id}-tint`}
      gradientUnits="userSpaceOnUse"
      x1={g.x1}
      y1="0"
      x2={g.x2}
      y2="0"
      gradientTransform={g.transform}
    >
      {g.fringe.map((s) => <stop offset={s.offset} stop-color={s.color} />)}
    </linearGradient>
  </defs>

  <rect width={g.width} height={g.height} fill="#000"></rect>
  <!-- A smooth glow carries the light; the static over it is texture. -->
  <rect
    width={g.width}
    height={g.height}
    fill={`url(#${id}-beam)`}
    mask={`url(#${id}-fade-mask)`}
    opacity={layers.glow}></rect>
  <g filter={`url(#${id}-dither)`} opacity={layers.grain}>
    <rect
      width={g.width}
      height={g.height}
      fill={`url(#${id}-beam)`}
      mask={`url(#${id}-fade-mask)`}></rect>
  </g>
  <rect
    width={g.width}
    height={g.height}
    fill={`url(#${id}-tint)`}
    style="mix-blend-mode: multiply"></rect>
</svg>

<style>
  .grain-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    background: #000;
    isolation: isolate;
  }
</style>

---
// Baseline's mark, used as Airship's: an "A" split by a runway.
import { brand } from "@airship/tokens/tokens";

interface Props {
  size?: number;
  wordmark?: boolean;
}
const { size = 20, wordmark = true } = Astro.props;
---

<span class="logo">
  <svg
    aria-hidden={wordmark ? "true" : undefined}
    aria-label={wordmark ? undefined : "Airship"}
    fill="none"
    height={size}
    role="img"
    viewBox={brand.markViewBox}
    width={size}
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d={brand.mark}
      fill="currentColor"
      fill-opacity="0.92"></path>
  </svg>
  {wordmark && <span class="logo-word">{brand.name}</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--white);
  }

  .logo-word {
    font-family: var(--font-sans);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.6px;
    line-height: 1;
  }
</style>

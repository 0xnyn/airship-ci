---
// Baseline's mark, used as Airship's: an "A" split by a runway.
interface Props {
  size?: number;
  wordmark?: boolean;
}
const { size = 20, wordmark = true } = Astro.props;
---

<span class="logo">
  <svg
    aria-hidden={wordmark ? "true" : undefined}
    aria-label={wordmark ? undefined : "Airship"}
    fill="none"
    height={size}
    role="img"
    viewBox="4 4 16 16"
    width={size}
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M12 5.1L4 18.9H8.53L14.27 9.01ZM16.53 12.92H12L15.47 18.9H20Z"
      fill="currentColor"
      fill-opacity="0.92"></path>
  </svg>
  {wordmark && <span class="logo-word">airship</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--white);
  }

  .logo-word {
    font-family: var(--font-sans);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.6px;
    line-height: 1;
  }
</style>

---
import Cta from "../components/cta.astro";
import Features from "../components/features.astro";
import Footer from "../components/footer.astro";
import Hero from "../components/hero.astro";
import HowItWorks from "../components/how-it-works.astro";
import Navbar from "../components/navbar.astro";
import Security from "../components/security.astro";
import { features, getStarted, hero, how, security } from "../content/home";
import { site } from "../content/site";
import Layout from "../layouts/layout.astro";
---

<Layout title={`${site.name} · ${site.tagline}`} description={site.description}>
  <Navbar />
  <main>
    <Hero content={hero} />
    <Features content={features} />
    <HowItWorks content={how} />
    <Security content={security} />
    <Cta content={getStarted} />
  </main>
  <Footer />
</Layout>

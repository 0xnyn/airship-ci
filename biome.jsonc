{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // Generated files are checked by drift CI, not by hand.
    "includes": [
      "!**/src/generated",
      "!apps/dash/src/env.ts",
      "!apps/api/openapi.json",
      "!apps/docs/api-reference/openapi.json"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "performance": {
        // React Compiler (next.config.ts) memoizes inline handlers already.
        "noJsxPropsBind": "off"
      }
    }
  },
  "overrides": [
    {
      // shadcn components are vendored from the registry and regenerated by
      // `shadcn add`; keep them diffable against upstream rather than hand-tuned.
      "includes": ["packages/ui/src/components/**", "packages/ui/src/lib/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "noNoninteractiveElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "performance": { "noBarrelFile": "off" },
          "style": { "noExportedImports": "off" }
        }
      }
    },
    {
      // Biome reads only an .astro file's frontmatter, so it can't see the
      // template using what the frontmatter declares (Biome's own advice).
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ]
}

# Settings for deploy/compose/compose.yaml. Copy to .env next to it and
# fill in every value. Keep .env out of version control.

# Two DNS names on the same domain, both pointing at this server.
API_DOMAIN=api.example.com
WEB_DOMAIN=app.example.com
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=ops@example.com

# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -base64 32. Back it up somewhere other than this server.
CREDENTIALS_KEY=

# The production GitHub App (docs/deploy/README.md, "The GitHub App").
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
# Without it nobody can sign in to the dashboard.
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# The app's private key, mounted read-only into the API container.
GITHUB_PRIVATE_KEY_PATH=./github-app.pem

# Optional (defaults shown).
# Image tag for the locally built images.
# AIRSHIP_VERSION=local
# LOG_LEVEL=info
# Bump with actions/runner releases: GitHub stops sending jobs to runners
# more than 30 days behind the latest release.
# RUNNER_VERSION=2.338.2
# RUNNER_MAX_LIFETIME=8h
# RUNNER_IDLE_TIMEOUT=10m

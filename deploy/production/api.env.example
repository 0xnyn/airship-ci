# Production settings for the API container (image: apps/api/Dockerfile).
# A template, not a file to deploy: put each value in your platform's
# environment or secret store. The guides in docs/deploy/ say which is
# which on AWS, GCP, Azure and Render. Lines marked SECRET belong in a
# secret store.

# The image sets these already. Platforms that assign a port (Render, Cloud
# Run) set PORT themselves, and the API listens on it.
# APP_ENV=production
# PORT=8080

# SECRET. Postgres. Use TLS (sslmode=require) unless you connect over a
# Unix socket, as Cloud Run does with Cloud SQL.
DATABASE_URL=postgres://airship:CHANGE_ME@db.internal.example.com:5432/airship?sslmode=require
# PlanetScale: the direct port 5432, never PgBouncer's 6432 (the API's
# advisory locks need a session). docs/deploy/planetscale.md.
# DATABASE_URL=postgres://airship:CHANGE_ME@<host>:5432/postgres?sslmode=verify-full
# Supabase: the session pooler (port 5432), never the transaction pooler's
# 6543. docs/deploy/supabase.md.
# DATABASE_URL=postgres://airship.<ref>:CHANGE_ME@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=require&pool_max_conns=4

# Public https URL of this API: GitHub webhooks, sign-in callbacks and
# runner machines all use it. Startup fails on plain http.
PUBLIC_URL=https://api.example.com
# The dashboard. Must be on the same site as PUBLIC_URL (for example
# app.example.com and api.example.com) or the session cookie is not sent.
WEB_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
LOG_LEVEL=info

# SECRET. Seals customers' cloud credentials. Generate once with
#   openssl rand -base64 32
# and back it up outside the database. Losing it means every customer
# reconnects their cloud. Rotation: "<new>,<old>", reconnect clouds, "<new>".
CREDENTIALS_KEY=

# The production GitHub App (docs/deploy/README.md, "The production GitHub
# App"). Startup fails without the client ID, the webhook secret and the
# private key. The slug builds the dashboard's "Install" link.
GITHUB_APP_SLUG=airship
GITHUB_CLIENT_ID=Iv23li...
# SECRET. Without it nobody can sign in to the dashboard.
GITHUB_CLIENT_SECRET=
# SECRET.
GITHUB_WEBHOOK_SECRET=
# SECRET. The PEM, either as the variable (real newlines, or one line with
# literal \n) ...
GITHUB_PRIVATE_KEY=
# ... or as a mounted file.
# GITHUB_PRIVATE_KEY_FILE=/run/secrets/github-app.pem

# GitHub Enterprise Server only (defaults shown).
# GITHUB_API_URL=https://api.github.com
# GITHUB_WEB_URL=https://github.com

# Runner lifecycle (defaults shown). Bump RUNNER_VERSION with actions/runner
# releases: GitHub stops sending jobs to runners more than 30 days behind
# the latest release.
# RUNNER_VERSION=2.338.2
# Machines power off after this, whatever they are doing.
# RUNNER_MAX_LIFETIME=8h
# A launched runner that gets no job in this long is reaped.
# RUNNER_IDLE_TIMEOUT=10m
# Rarely changed: how often the reconciler runs, and the longest a pending
# runner waits for a launch pass.
# RECONCILE_INTERVAL=15s
# LAUNCH_INTERVAL=2s

# Never set in production: DEV_LOGIN (startup fails), and AWS_ENDPOINT,
# GCP_ENDPOINT, AZURE_ENDPOINT, DAYTONA_ENDPOINT (they send launches to an
# emulator instead of the real cloud).

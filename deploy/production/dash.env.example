# Production settings for the dashboard image (apps/dash/Dockerfile).

# BUILD TIME. Passed as --build-arg; inlined into the JavaScript by
# `next build`. A different API URL needs a new image. Localhost is refused.
NEXT_PUBLIC_API_URL=https://api.example.com
# The dashboard's own URL, for the social card in link previews. Optional on
# Vercel, which supplies its production URL.
NEXT_PUBLIC_APP_URL=https://app.example.com

# Vercel (docs/deploy/stage-0/5-vercel.md): set NEXT_PUBLIC_API_URL for the
# Production and Preview environments, plus this, so Vercel uses the pnpm
# version pinned in package.json:
# ENABLE_EXPERIMENTAL_COREPACK=1

# RUN TIME, for the Docker image only. The image sets these already.
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0

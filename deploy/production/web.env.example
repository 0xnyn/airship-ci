# Production settings for the dashboard image (apps/web/Dockerfile).

# BUILD TIME. Passed as --build-arg; inlined into the JavaScript by
# `next build`. A different API URL needs a new image. Localhost is refused.
NEXT_PUBLIC_API_URL=https://api.example.com

# RUN TIME. The image sets these already.
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0

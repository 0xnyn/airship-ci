{
  "name": "airship",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:generated",
    "check:generated": "pnpm generate && git diff --exit-code -- apps/api/openapi.json apps/api/internal/db apps/docs/api-reference/openapi.json packages/client/src/generated packages/tokens/src/generated apps/home/public/favicon.svg apps/dash/src/app/icon.svg apps/docs/favicon.svg apps/docs/logo",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @airship/api db:migrate",
    "db:new": "pnpm --filter @airship/api db:new",
    "db:rollback": "pnpm --filter @airship/api db:rollback",
    "db:up": "docker compose up --detach --wait postgres",
    "dev": "turbo run dev --filter=!@airship/docs",
    "format": "ultracite fix && turbo run format",
    "generate": "turbo run generate",
    "postinstall": "varlock codegen --path ./apps/dash/",
    "lint": "ultracite check && turbo run lint",
    "prepare": "husky",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css,md}": "ultracite fix",
    "apps/api/**/*.go": "gofmt -w"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "catalog:",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "turbo": "2.11.10",
    "typescript": "catalog:",
    "ultracite": "8.0.2",
    "varlock": "catalog:"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  }
}
